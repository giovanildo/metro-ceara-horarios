<?xml version="1.0" encoding="utf-8"?>
<!-- Só na versão de teste (build "campo"): permissões dos experimentos de campo do
     modo viagem, nas opções de desenvolvedor. O app da Play não tem nenhuma delas. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Gravar o som da viagem (TripAudioRecorder), só durante o modo viagem. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Ver as redes Wi-Fi e pedir uma busca (RadioRecorder). Não conecta a nenhuma rede. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Buscar aparelhos Bluetooth por perto (BleRecorder). Não conecta a nenhum.
         Sem neverForLocation de propósito: a ideia é justamente reconhecer o lugar. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <application>
        <service
            android:name=".trip.TripService"
            android:exported="false"
            android:foregroundServiceType="location|microphone"
            tools:replace="android:foregroundServiceType" />
    </application>
</manifest>

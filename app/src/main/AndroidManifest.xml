<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Os horarios ficam todos no banco embarcado; a localizacao serve apenas
         para descobrir a estacao mais proxima, e o app funciona sem ela. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Para baixar os horarios do dia do Metrofor (GTFS). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Modo viagem: segue o GPS com a tela desligada e avisa antes do destino. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- Android 11+: sem isto o app nao enxerga o motor de voz (TextToSpeech). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".MetroApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MetroCeara">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MetroCeara">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Envio do registro de testes (opções de desenvolvedor). -->

        <!-- Widgets da tela inicial: a estação fixada (ou a última aberta) e os próximos horários. -->
        <receiver
            android:name=".widget.StationWidgetWide"
            android:exported="false"
            android:label="@string/widget_wide_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_wide_info" />
        </receiver>
        <receiver
            android:name=".widget.StationWidgetSmall"
            android:exported="false"
            android:label="@string/widget_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_small_info" />
        </receiver>

        <!-- O ↻ do widget: uma localização, por poucos segundos. -->
        <service
            android:name=".widget.WidgetLocateService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".trip.TripService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>

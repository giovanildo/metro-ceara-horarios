<?xml version="1.0" encoding="utf-8"?>
<!-- Backup na nuvem e cópia para outro celular, do Android 12 em diante. Vai tudo, menos a
     marca da primeira abertura (HomeLayoutStore.FIRST_RUN_PREFS); ver backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="metrofor_primeira_abertura.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="metrofor_primeira_abertura.xml" />
    </device-transfer>
</data-extraction-rules>

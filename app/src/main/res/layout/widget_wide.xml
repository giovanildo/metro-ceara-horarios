<?xml version="1.0" encoding="utf-8"?>
<!-- Widget da estação (largo, 4×2). Os textos são de exemplo (aparecem na lista de widgets); StationWidget troca tudo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="●"
                android:textColor="#ED1C24"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_station"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Benfica"
                android:textColor="@color/widget_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Linha Sul"
                android:textColor="@color/widget_muted"
                android:textSize="13sp"
                android:visibility="visible" />
        </LinearLayout>

        <!-- Procura a estação mais perto pelo GPS (StationWidget.refreshIntent). -->
        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="-8dp"
            android:contentDescription="@string/widget_refresh"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:text="↻"
            android:textColor="@color/widget_muted"
            android:textSize="20sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_dir1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="→ Carlito Benevides"
            android:textColor="@color/widget_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_time1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07:40"
                android:textColor="@color/widget_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_more1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="07:53"
                android:textColor="@color/widget_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_dir2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="→ Chico da Silva"
            android:textColor="@color/widget_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_time2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07:34"
                android:textColor="@color/widget_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_more2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="07:52"
                android:textColor="@color/widget_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_note"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_note_warning"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:textColor="@color/widget_warning_text"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
